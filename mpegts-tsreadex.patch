+/**
+ * Extract an ARIB STD-B24 caption payload carried inside an ID3 timed
+ * metadata PES packet (as produced by tsreadex and friends, which wrap the
+ * caption PES in an ID3v2 PRIV frame owned by "aribb24.js").
+ *
+ * On success the packet payload is replaced by the raw ARIB data, the stream
+ * is re-tagged as ARIB caption and 1 is returned.
+ *
+ * A payload that is not an ARIB caption is dropped, not forwarded: the stream
+ * is re-tagged on the first caption packet and stays tagged from then on, so
+ * forwarding the untouched ID3 tag would hand "ID3..." to libaribcaption, which
+ * rejects it with "Invalid data_identifier". FFERROR_REDO tells the framework
+ * to read the next packet instead.
+ *
+ * @return 1 if the packet now carries ARIB caption data,
+ *         FFERROR_REDO if the packet is not an ARIB caption and must be
+ *                      dropped, or 0 if the packet is not an ARIB stream at all
+ *         (a plain timed ID3 packet, left untouched).
+ */
+static int timed_id3_extract_arib(PESContext *pes, AVPacket *pkt)
+{
+    FFIOContext id3_buf;
+    ID3v2ExtraMeta *extra_meta = NULL;
+    ID3v2ExtraMeta *cur;
+    AVDictionary *metadata = NULL;
+    AVBufferRef *buf = NULL;
+    int ret = 0;
+
+    if (pkt->size < ID3v2_HEADER_SIZE ||
+        !ff_id3v2_match(pkt->data, ID3v2_DEFAULT_MAGIC))
+        return 0;
+
+    ffio_init_read_context(&id3_buf, pkt->data, pkt->size);
+    ff_id3v2_read_dict(&id3_buf.pub, &metadata,
+                      ID3v2_DEFAULT_MAGIC, &extra_meta);
+
+    for (cur = extra_meta; cur; cur = cur->next) {
+        ID3v2ExtraMetaPRIV *priv;
+
+        if (strcmp(cur->tag, "PRIV"))
+            continue;
+
+        priv = &cur->data.priv;
+        if (strcmp((const char *)priv->owner, "aribb24.js") ||
+            priv->datasize < 1)
+            continue;
+
+        /* 0x80 is caption, 0x81 is superimpose. libaribcaption is set up for
+         * ARIBCC_CAPTIONTYPE_CAPTION and rejects superimpose with a
+         * "data_identifier mismatch" error, so only caption is usable. */
+        if (priv->data[0] != 0x80)
+            break;
+
+        buf = av_buffer_alloc(priv->datasize + AV_INPUT_BUFFER_PADDING_SIZE);
+        if (!buf) {
+            ret = AVERROR(ENOMEM);
+            goto end;
+        }
+
+        memcpy(buf->data, priv->data, priv->datasize);
+        memset(buf->data + priv->datasize, 0,
+               AV_INPUT_BUFFER_PADDING_SIZE);
+
+        av_buffer_unref(&pkt->buf);
+        pkt->buf = buf;
+        buf = NULL;
+        pkt->data = pkt->buf->data;
+        pkt->size = priv->datasize;
+
+        {
+            FFStream *const sti = ffstream(pes->st);
+            int video_index;
+
+            pes->st->codecpar->codec_type = AVMEDIA_TYPE_SUBTITLE;
+            pes->st->codecpar->codec_id   = AV_CODEC_ID_ARIB_CAPTION;
+            pes->st->codecpar->profile    = AV_PROFILE_ARIB_PROFILE_A;
+            pes->st->disposition |= AV_DISPOSITION_DEFAULT;
+            av_dict_set(&pes->st->metadata, "language", "jpn",
+                        AV_DICT_DONT_OVERWRITE);
+
+            video_index = av_find_best_stream(pes->stream, AVMEDIA_TYPE_VIDEO,
+                                               -1, 1, NULL, 0);
+            if (video_index >= 0) {
+                AVStream *video_st = pes->stream->streams[video_index];
+                pes->st->codecpar->width  = video_st->codecpar->width;
+                pes->st->codecpar->height = video_st->codecpar->height;
+            }
+
+            sti->need_parsing = AVSTREAM_PARSE_NONE;
+            sti->need_context_update = 1;
+        }
+
+        ret = 1;
+        goto end;
+    }
+
+    /* An "aribb24.js" payload that is not a caption (superimpose, or anything
+     * else) is not decodable as ARIB caption; drop it. */
+    if (pes->st->codecpar->codec_id == AV_CODEC_ID_ARIB_CAPTION)
+        ret = FFERROR_REDO;
+
+end:
+    av_buffer_unref(&buf);
+    ff_id3v2_free_extra_meta(&extra_meta);
+    av_dict_free(&metadata);
+    return ret;
+}
